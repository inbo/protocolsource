# dot files
.Rhistory
.Rapp.history
.DS_Store
.Renviron
.Rproj.user
.Ruserdata
.quarto

# Session Data files
*.[rR][dD]ata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

